{
  "name": "@lightstage/react",
  "version": "0.1.1",
  "private": true,
  "description": "Shared stylized CSS light for real React surfaces",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "docs",
    "skills",
    "scripts/install-agent-skill.mjs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && vite --host 127.0.0.1",
    "build": "npm run build:lib && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "node scripts/check-package.mjs",
    "build:lib": "tsc -p tsconfig.lib.json && node scripts/dependency-notices.mjs && node scripts/build.mjs",
    "prepack": "npm run build:lib",
    "test:original": "node scripts/check-original.cjs",
    "notices": "node scripts/dependency-notices.mjs",
    "install:skill": "node scripts/install-agent-skill.mjs",
    "public:check": "node scripts/check-public-install.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "author": "Hiren Thakore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thakoreh/lightstage.git"
  },
  "homepage": "https://github.com/thakoreh/lightstage#readme"
}
